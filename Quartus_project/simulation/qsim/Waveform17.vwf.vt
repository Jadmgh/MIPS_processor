// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "03/16/2025 16:13:36"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    fu_TEST
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module fu_TEST_vlg_sample_tst(
	RR1,
	RR2,
	RS,
	RT,
	WR1,
	WR2,
	sampler_tx
);
input [4:0] RR1;
input [4:0] RR2;
input [4:0] RS;
input [4:0] RT;
input  WR1;
input  WR2;
output sampler_tx;

reg sample;
time current_time;
always @(RR1 or RR2 or RS or RT or WR1 or WR2)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module fu_TEST_vlg_check_tst (
	MUX1,
	MUX2,
	sampler_rx
);
input [1:0] MUX1;
input [1:0] MUX2;
input sampler_rx;

reg [1:0] MUX1_expected;
reg [1:0] MUX2_expected;

reg [1:0] MUX1_prev;
reg [1:0] MUX2_prev;

reg [1:0] MUX1_expected_prev;
reg [1:0] MUX2_expected_prev;

reg [1:0] last_MUX1_exp;
reg [1:0] last_MUX2_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:2] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 2'b1;
end

// update real /o prevs

always @(trigger)
begin
	MUX1_prev = MUX1;
	MUX2_prev = MUX2;
end

// update expected /o prevs

always @(trigger)
begin
	MUX1_expected_prev = MUX1_expected;
	MUX2_expected_prev = MUX2_expected;
end


// expected MUX1[ 1 ]
initial
begin
	MUX1_expected[1] = 1'bX;
end 
// expected MUX1[ 0 ]
initial
begin
	MUX1_expected[0] = 1'bX;
end 
// expected MUX2[ 1 ]
initial
begin
	MUX2_expected[1] = 1'bX;
end 
// expected MUX2[ 0 ]
initial
begin
	MUX2_expected[0] = 1'bX;
end 
// generate trigger
always @(MUX1_expected or MUX1 or MUX2_expected or MUX2)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected MUX1 = %b | expected MUX2 = %b | ",MUX1_expected_prev,MUX2_expected_prev);
	$display("| real MUX1 = %b | real MUX2 = %b | ",MUX1_prev,MUX2_prev);
`endif
	if (
		( MUX1_expected_prev[0] !== 1'bx ) && ( MUX1_prev[0] !== MUX1_expected_prev[0] )
		&& ((MUX1_expected_prev[0] !== last_MUX1_exp[0]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port MUX1[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", MUX1_expected_prev);
		$display ("     Real value = %b", MUX1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_MUX1_exp[0] = MUX1_expected_prev[0];
	end
	if (
		( MUX1_expected_prev[1] !== 1'bx ) && ( MUX1_prev[1] !== MUX1_expected_prev[1] )
		&& ((MUX1_expected_prev[1] !== last_MUX1_exp[1]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port MUX1[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", MUX1_expected_prev);
		$display ("     Real value = %b", MUX1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_MUX1_exp[1] = MUX1_expected_prev[1];
	end
	if (
		( MUX2_expected_prev[0] !== 1'bx ) && ( MUX2_prev[0] !== MUX2_expected_prev[0] )
		&& ((MUX2_expected_prev[0] !== last_MUX2_exp[0]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port MUX2[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", MUX2_expected_prev);
		$display ("     Real value = %b", MUX2_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_MUX2_exp[0] = MUX2_expected_prev[0];
	end
	if (
		( MUX2_expected_prev[1] !== 1'bx ) && ( MUX2_prev[1] !== MUX2_expected_prev[1] )
		&& ((MUX2_expected_prev[1] !== last_MUX2_exp[1]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port MUX2[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", MUX2_expected_prev);
		$display ("     Real value = %b", MUX2_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_MUX2_exp[1] = MUX2_expected_prev[1];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module fu_TEST_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [4:0] RR1;
reg [4:0] RR2;
reg [4:0] RS;
reg [4:0] RT;
reg WR1;
reg WR2;
// wires                                               
wire [1:0] MUX1;
wire [1:0] MUX2;

wire sampler;                             

// assign statements (if any)                          
fu_TEST i1 (
// port map - connection between master ports and signals/registers   
	.MUX1(MUX1),
	.MUX2(MUX2),
	.RR1(RR1),
	.RR2(RR2),
	.RS(RS),
	.RT(RT),
	.WR1(WR1),
	.WR2(WR2)
);
// RS[ 4 ]
initial
begin
	RS[4] = 1'b0;
end 
// RS[ 3 ]
initial
begin
	RS[3] = 1'b0;
end 
// RS[ 2 ]
initial
begin
	RS[2] = 1'b0;
end 
// RS[ 1 ]
initial
begin
	RS[1] = 1'b1;
end 
// RS[ 0 ]
initial
begin
	RS[0] = 1'b0;
end 
// RR1[ 4 ]
initial
begin
	RR1[4] = 1'b0;
end 
// RR1[ 3 ]
initial
begin
	RR1[3] = 1'b0;
end 
// RR1[ 2 ]
initial
begin
	RR1[2] = 1'b0;
end 
// RR1[ 1 ]
initial
begin
	RR1[1] = 1'b1;
end 
// RR1[ 0 ]
initial
begin
	RR1[0] = 1'b0;
end 
// RR2[ 4 ]
initial
begin
	RR2[4] = 1'b0;
end 
// RR2[ 3 ]
initial
begin
	RR2[3] = 1'b0;
end 
// RR2[ 2 ]
initial
begin
	RR2[2] = 1'b0;
end 
// RR2[ 1 ]
initial
begin
	RR2[1] = 1'b1;
end 
// RR2[ 0 ]
initial
begin
	RR2[0] = 1'b0;
end 
// RT[ 4 ]
initial
begin
	RT[4] = 1'b0;
end 
// RT[ 3 ]
initial
begin
	RT[3] = 1'b0;
end 
// RT[ 2 ]
initial
begin
	RT[2] = 1'b0;
end 
// RT[ 1 ]
initial
begin
	RT[1] = 1'b1;
end 
// RT[ 0 ]
initial
begin
	RT[0] = 1'b1;
end 

// WR1
initial
begin
	WR1 = 1'b0;
	WR1 = #70000 1'b1;
	WR1 = #90000 1'b0;
	WR1 = #130000 1'b1;
	WR1 = #180000 1'b0;
end 

// WR2
initial
begin
	WR2 = 1'b0;
	WR2 = #160000 1'b1;
	WR2 = #310000 1'b0;
end 

fu_TEST_vlg_sample_tst tb_sample (
	.RR1(RR1),
	.RR2(RR2),
	.RS(RS),
	.RT(RT),
	.WR1(WR1),
	.WR2(WR2),
	.sampler_tx(sampler)
);

fu_TEST_vlg_check_tst tb_out(
	.MUX1(MUX1),
	.MUX2(MUX2),
	.sampler_rx(sampler)
);
endmodule

