initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module Lab3_vlg_vec_tst();
// constants                                           
// general purpose registers
reg GClock;
reg GReset;
reg RAM_Clock;
// wires                                               
wire [7:0] Address_to_w_r_MEM;
wire [2:0] ALU_Control;
wire [7:0] ALUop1;
wire [7:0] ALUop2;
wire [7:0] ALUResultEX;
wire [7:0] Data_from_address_MEM;
wire [7:0] Data_goingtobe;
wire [7:0] DataRS;
wire [7:0] DataRT;
wire [31:0] Instruction_EX;
wire [31:0] Instruction_ID;
wire [31:0] Instruction_IF;
wire [31:0] Instruction_MEM;
wire [31:0] Instruction_WB;
wire [7:0] PCValue;
wire [4:0] rsIF;
wire [4:0] rtIF;

wire sampler;                             

// assign statements (if any)                          
Lab3 i1 (
// port map - connection between master ports and signals/registers   
	.Address_to_w_r_MEM(Address_to_w_r_MEM),
	.ALU_Control(ALU_Control),
	.ALUop1(ALUop1),
	.ALUop2(ALUop2),
	.ALUResultEX(ALUResultEX),
	.Data_from_address_MEM(Data_from_address_MEM),
	.Data_goingtobe(Data_goingtobe),
	.DataRS(DataRS),
	.DataRT(DataRT),
	.GClock(GClock),
	.GReset(GReset),
	.Instruction_EX(Instruction_EX),
	.Instruction_ID(Instruction_ID),
	.Instruction_IF(Instruction_IF),
	.Instruction_MEM(Instruction_MEM),
	.Instruction_WB(Instruction_WB),
	.PCValue(PCValue),
	.RAM_Clock(RAM_Clock),
	.rsIF(rsIF),
	.rtIF(rtIF)
);

// GClock
always
begin
	GClock = 1'b0;
	GClock = #20000 1'b1;
	#20000;
end 

// RAM_Clock
always
begin
	RAM_Clock = 1'b0;
	RAM_Clock = #5000 1'b1;
	#5000;
end 

// GReset
initial
begin
	GReset = 1'b1;
	GReset = #10000 1'b0;
end 

Lab3_vlg_sample_tst tb_sample (
	.GClock(GClock),
	.GReset(GReset),
	.RAM_Clock(RAM_Clock),
	.sampler_tx(sampler)
);

Lab3_vlg_check_tst tb_out(
	.Address_to_w_r_MEM(Address_to_w_r_MEM),
	.ALU_Control(ALU_Control),
	.ALUop1(ALUop1),
	.ALUop2(ALUop2),
	.ALUResultEX(ALUResultEX),
	.Data_from_address_MEM(Data_from_address_MEM),
	.Data_goingtobe(Data_goingtobe),
	.DataRS(DataRS),
	.DataRT(DataRT),
	.Instruction_EX(Instruction_EX),
	.Instruction_ID(Instruction_ID),
	.Instruction_IF(Instruction_IF),
	.Instruction_MEM(Instruction_MEM),
	.Instruction_WB(Instruction_WB),
	.PCValue(PCValue),
	.rsIF(rsIF),
	.rtIF(rtIF),
	.sampler_rx(sampler)
);
endmodule

