library ieee;
use ieee.std_logic_1164.all;

------------------------------------------------------------------
-- d_latch (provided)
------------------------------------------------------------------
entity d_latch is
    Port ( D : in STD_LOGIC;
           EN : in STD_LOGIC;
           Q  : out STD_LOGIC);
end d_latch;

architecture Structural of d_latch is
    signal s, r, q_internal, q_not_internal : STD_LOGIC;
begin
    s <= EN nand D;
    r <= EN nand (not D);
    q_internal <= s nand q_not_internal;
    q_not_internal <= r nand q_internal;
    Q <= q_internal;
end Structural;

------------------------------------------------------------------
-- d_ff: Edge-triggered D Flip-Flop built from two d_latches
------------------------------------------------------------------
entity d_ff is
    Port ( D   : in  STD_LOGIC;
           clk : in  STD_LOGIC;
           Q   : out STD_LOGIC);
end d_ff;

architecture Structural of d_ff is
    signal master_out, clk_bar : STD_LOGIC;
begin
    clk_bar <= not clk;

    master_latch: d_latch 
        port map (
            D  => D,
            EN => clk_bar,  -- Transparent when clk is LOW
            Q  => master_out
        );

    slave_latch: d_latch 
        port map (
            D  => master_out,
            EN => clk,      -- Transparent when clk is HIGH
            Q  => Q
        );
end Structural;

------------------------------------------------------------------
-- IFID: Structural Gate-Level Implementation using d_ff's and
--        a combinational multiplexer for enable and flush.
------------------------------------------------------------------
entity IFID is
    port(
         clk   : in  std_logic;
         en    : in  std_logic;
         flush : in  std_logic;
         i_pc4 : in  std_logic_vector(7 downto 0);
         i_ins : in  std_logic_vector(31 downto 0);
         o_pc4 : out std_logic_vector(7 downto 0);
         o_ins : out std_logic_vector(31 downto 0)
    );
end IFID;

architecture Structural of IFID is

    -- Instantiate d_ff (built from d_latch)
    component d_ff is
        Port ( D   : in  std_logic;
               clk : in  std_logic;
               Q   : out std_logic);
    end component;

    -- Signals for the 32-bit PC register
    signal pc4_reg : std_logic_vector(31 downto 0);
    signal pc4_d   : std_logic_vector(31 downto 0);
    signal i_32_pc4: std_logic_vector(31 downto 0);

    -- Signals for the 32-bit Instruction register
    signal ins_reg : std_logic_vector(31 downto 0);
    signal ins_d   : std_logic_vector(31 downto 0);

begin

    ----------------------------------------------------------------------------
    -- Extend i_pc4 to 32 bits (upper 24 bits set to '0')
    ----------------------------------------------------------------------------
    i_32_pc4 <= (others => '0');
    i_32_pc4(7 downto 0) <= i_pc4;

    ----------------------------------------------------------------------------
    -- For each bit, determine the next value using a 2:1 multiplexer.
    -- The multiplexer implements the following:
    --    if flush = '1' then load '0'
    --    else if en = '1' then load new data
    --    else hold the current value.
    --
    -- This is expressed as:
    --    D_input = (not flush) and [ (en and Data) or ((not en) and Q) ]
    ----------------------------------------------------------------------------

    -- PC register (32 bits)
    gen_pc: for i in 0 to 31 generate
        pc4_d(i) <= (not flush) and ((en and i_32_pc4(i)) or ((not en) and pc4_reg(i)));
        pc4_ff: d_ff port map (
            D   => pc4_d(i),
            clk => clk,
            Q   => pc4_reg(i)
        );
    end generate;

    -- Instruction register (32 bits)
    gen_ins: for i in 0 to 31 generate
        ins_d(i) <= (not flush) and ((en and i_ins(i)) or ((not en) and ins_reg(i)));
        ins_ff: d_ff port map (
            D   => ins_d(i),
            clk => clk,
            Q   => ins_reg(i)
        );
    end generate;

    ----------------------------------------------------------------------------
    -- Output assignments:
    -- o_pc4 is assigned the lower 8 bits of the PC register.
    -- o_ins is the full 32-bit instruction register.
    ----------------------------------------------------------------------------
    o_pc4 <= pc4_reg(7 downto 0);
    o_ins <= ins_reg;

end Structural;
